{
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.js",
    "build": "node scripts/build-all.js",
    "dev:cli": "node scripts/run-cli.js",
    "dev:web": "node scripts/run-web.js",
    "preview": "node scripts/preview.js",
    "test": "node scripts/test.js",
    "test:rust": "node scripts/test-rust.js",
    "test:web": "node scripts/test-web.js",
    "check": "node scripts/check.js",
    "check:rust": "node scripts/check-rust.js",
    "check:web": "node scripts/check-web.js",
    "clean": "node scripts/clean.js",
    "tauri": "npx @tauri-apps/cli",
    "build:desktop": "node scripts/build-desktop.js",
    "dev:desktop": "cd crates/tetris-tauri && cargo tauri dev",
    "build:ai": "cd crates/tetris-ai && python build_ai.py",
